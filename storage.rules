rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /labels/{userId}/{recipeId} {
      // Authenticated users can upload their own labels
      allow create, update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      // Authenticated users can delete their own labels
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
      // Anyone can read (labels on public recipes are visible)
      allow read: if true;
    }
  }
}
